{
  "schema": 2,
  "permissions": [
    "tools.invoke",
    "chat.write_message",
    "storage.read",
    "storage.write"
  ],
  "host_capabilities": [
    "llm.sample",
    "aps.kv",
    "aps.scope.user.read",
    "aps.scope.user.write"
  ],
  "required_executas": [
    {
      "tool_id": "bundled:inbox-executa",
      "min_version": "2.0.9",
      "version": "latest"
    }
  ],
  "optional_executas": [],
  "system_prompt_addendum": "Anna Inbox is a Gmail workspace with inbox sync, thread actions, drafts, attachments, Brief workflows, and mailbox search. Credentials are supplied by Anna authorization or the Executa credential context; never ask the user to paste API keys or OAuth tokens.",
  "tags": [
    "email",
    "gmail",
    "oauth",
    "llm"
  ],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": [
        "https://claude.ai"
      ]
    },
    "views": [
      {
        "name": "main",
        "title": "Anna Inbox",
        "default": true,
        "entry": "index.html",
        "min_size": {
          "w": 760,
          "h": 560
        },
        "default_size": {
          "w": 1600,
          "h": 900
        },
        "max_size": {
          "w": 4096,
          "h": 4096
        },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "tools": [
        "required:bundled:inbox-executa"
      ],
      "chat": [
        "write_message"
      ],
      "storage": [
        "get",
        "set",
        "list",
        "delete"
      ],
      "llm": [
        "complete",
        "sampling"
      ],
      "window": [
        "set_title"
      ],
      "agent": {
        "session": {
          "auto": true,
          "fixed": {}
        },
        "tools": []
      }
    },
    "csp_overrides": {
      "script-src": [
        "'self'"
      ],
      "style-src": [
        "'self'"
      ],
      "connect-src": [
        "'self'",
        "blob:",
        "https:",
        "http://127.0.0.1:*"
      ],
      "img-src": [
        "'self'",
        "data:",
        "blob:",
        "https:"
      ],
      "media-src": [
        "'self'",
        "blob:",
        "https:",
        "http://127.0.0.1:*"
      ]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": [],
    "user_id": 1
  }
}
